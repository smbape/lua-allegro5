+        list_cmake_path(NORMAL_PATH target_INCLUDE_DIRECTORIES OUTPUT_VARIABLE)
+        list(TRANSFORM values_PUBLIC_AND_INTERFACE REPLACE "^${PROJECT_SOURCE_DIR}/" "")
+        list(TRANSFORM values_PUBLIC_AND_INTERFACE REPLACE "/$" "")
+
+        list(APPEND MONOLITH_INCLUDE_DIRECTORIES ${target_INCLUDE_DIRECTORIES})
+        unset(target_INCLUDE_DIRECTORIES)
     else()
         add_our_library(${target} ${framework_name} "${sources}" "${extra_flags}" "${link_with}")
         target_include_directories(${target} INTERFACE
